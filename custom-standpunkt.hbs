{{!< default}}

<main class="gh-main standpunkt">
    {{#post}}
        <article class="gh-article {{post_class}}">

            <header class="gh-article-header gh-canvas">

                <h3 class="standpunkt-title">STANDPUNKT</h3>

                <h1 class="gh-article-title">{{title}}</h1>

                {{> "post-meta"}}

            </header>

            <section class="gh-content gh-canvas">
                {{content}}
            </section>

            <footer class="gh-article-footer gh-canvas">
                <div class="gh-author-name-list">
                    {{#foreach authors}}
                        <h4 class="gh-author-name">

                            {{#if cover_image}} <!--Use cover_image as signature-->
                                <img src="{{cover_image}}" alt="{{name}}">
                            {{/if}}
                            <a href="{{url}}">{{name}}</a>
                        </h4>
                        {{#unless @last}}&nbsp;/&nbsp;{{/unless}}
                    {{/foreach}}
                </div>
            </footer>

        </article>
    {{/post}}

    {{> "related-posts"}}

    {{#post}}
        {{> "comments"}}
    {{/post}}
</main>